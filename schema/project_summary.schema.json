{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RNAFlow BioReport delivery v2.1",
  "type": "object",
  "required": ["schema_version", "path_base", "project", "input_files", "platform", "files", "software_versions", "enrichment"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "path_base": {"const": "."},
    "project": {
      "type": "object",
      "required": ["project_id", "user_id", "client", "species", "genome_version", "pipeline_version", "analysis_date"],
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "user_id": {"type": "string", "minLength": 1},
        "client": {"type": "string", "minLength": 1},
        "species": {"type": "string", "minLength": 1},
        "genome_version": {"type": "string", "minLength": 1},
        "pipeline_version": {"type": "string", "minLength": 1},
        "analysis_date": {"type": "string", "format": "date"},
        "report_date": {"type": "string", "format": "date"}
      }
    },
    "platform": {
      "type": "object",
      "required": ["report_id", "task_id", "flow_type", "flow_version", "title", "status", "generated_at", "expire_at", "html_entry"],
      "additionalProperties": false,
      "properties": {
        "report_id": {"type": "string", "pattern": "^.+_\\d{8}-\\d{6}$"},
        "task_id": {"type": "string", "minLength": 1},
        "flow_type": {"type": "string", "minLength": 1},
        "flow_version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "expire_at": {"type": ["string", "null"], "format": "date-time"},
        "html_entry": {"type": "string", "minLength": 1}
      }
    },
    "input_files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/path"}},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "description", "format"],
        "additionalProperties": false,
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "role": {"enum": ["expression_matrix_tpm", "expression_matrix_count", "sample_metadata", "contrast_definition", "deg_table", "enrichment_table", "qc_stats", "qc_report", "figure", "log", "other"]},
          "description": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "contrast": {"type": "string", "minLength": 1},
          "direction": {"enum": ["UP", "DOWN"]},
          "ontology": {"enum": ["GO", "KEGG"]}
        },
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "deg_table"}}},
            "then": {"required": ["contrast"]}
          },
          {
            "if": {"properties": {"role": {"const": "enrichment_table"}}},
            "then": {"required": ["contrast", "direction", "ontology"]}
          }
        ]
      }
    },
    "software_versions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["Software", "Version"], "additionalProperties": false,
        "properties": {
          "Software": {"type": "string", "minLength": 1},
          "Version": {"type": "string", "minLength": 1},
          "Link": {"type": "string", "pattern": "^https?://"}
        }
      }
    },
    "enrichment": {
      "type": "object", "required": ["go", "kegg"], "additionalProperties": false,
      "properties": {"go": {"$ref": "#/$defs/analysis"}, "kegg": {"$ref": "#/$defs/analysis"}}
    },
    "stats": {
      "type": "object", "additionalProperties": false,
      "properties": {"total_samples": {"type": "integer", "minimum": 0}, "group_count": {"type": "integer", "minimum": 0}}
    },
    "analysis": {"type": "object"},
    "report": {"type": "object"},
    "ai": {"type": "object"}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^data(?:/|$)", "minLength": 4},
    "direction": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {
        "status": {"enum": ["available", "no_results", "unavailable", "disabled", "failed"]},
        "table": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "full_table": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "term_count": {"type": "integer", "minimum": 0},
        "messages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "analysis": {
      "type": "object", "required": ["enabled", "method", "parameters", "contrasts"], "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "method": {"type": "string"},
        "parameters": {
          "type": "object", "additionalProperties": true,
          "properties": {
            "cutoff": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          }
        },
        "contrasts": {"type": "object", "additionalProperties": {"type": "object", "required": ["UP", "DOWN"], "additionalProperties": false, "properties": {"UP": {"$ref": "#/$defs/direction"}, "DOWN": {"$ref": "#/$defs/direction"}}}}
      },
      "allOf": [{
        "if": {"properties": {"enabled": {"const": true}}},
        "then": {"required": ["method", "parameters", "contrasts"], "properties": {"parameters": {"required": ["cutoff"]}}}
      }]
    }
  }
}
